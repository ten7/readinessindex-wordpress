{
  "name": "scan-status/running",
  "description": "Running, with progress.",
  "request": {
    "method": "GET",
    "path": "/cms/v1/scan/scan-token-4",
    "headers": {
      "Authorization": "Bearer <cms key>",
      "User-Agent": "ReadinessIndex-WordPress/1.2.0 WordPress/6.6; https://example.com"
    }
  },
  "response": {
    "status": 200,
    "headers": {},
    "shape": "ScanStatus",
    "body": {
      "scan": "scan-token-4",
      "state": "running",
      "finished_at": null,
      "progress": {
        "pages_read": 4,
        "pages_total": 10,
        "checks_done": 12,
        "checks_total": 51
      },
      "problem": null
    }
  }
}
