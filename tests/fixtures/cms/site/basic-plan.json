{
  "name": "site/basic-plan",
  "description": "A Basic subscriber: monthly rescans, a pack may be bought (`can_buy_pack`), and no `next_step`.",
  "request": {
    "method": "GET",
    "path": "/cms/v1/site",
    "headers": {
      "Authorization": "Bearer <cms key>",
      "User-Agent": "ReadinessIndex-WordPress/1.2.0 WordPress/6.6; https://example.com"
    }
  },
  "response": {
    "status": 200,
    "headers": {},
    "shape": "SiteResponse",
    "body": {
