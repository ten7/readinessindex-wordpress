        "host": "example.com",
        "verified": false
      },
      "scan": {
        "state": "none",
        "token": null,
        "finished_at": null,
        "pages_read": null,
        "truncated": {
          "pages": false,
          "time": false
        },
        "problem": null
      },
      "score": null,
      "fixes": [],
      "allowance": {
        "rescans_left": 10,
        "rescans_total": 10,
        "plan": "Basic",
        "lifetime": false,
        "can_buy_pack": true,
        "standing": {
          "state": "subscribed",
          "days_left": null,
          "writable": true
        },
        "next_step": null,
        "pack_url": "https://readinessindex.io/dashboard"
      },
      "index": {
        "version": "12.1",
        "date": "2026-10-21"
      },
      "notices": []
    }
  }
}
