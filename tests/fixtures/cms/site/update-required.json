{
  "name": "site/update-required",
  "description": "A module older than the server's minimum is told so in `notices` and in the `X-Readiness-Notice` header; the call still works.",
  "request": {
    "method": "GET",
    "path": "/cms/v1/site",
    "headers": {
      "Authorization": "Bearer <cms key>",
      "User-Agent": "ReadinessIndex-WordPress/1.2.0 WordPress/6.6; https://example.com"
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "x-readiness-notice": "module_update_required"
    },
    "shape": "SiteResponse",
    "body": {
      "site": {
        "host": "example.com",
        "verified": false
      },
      "scan": {
        "state": "none",
        "token": null,
        "finished_at": null,
        "pages_read": null,
        "truncated": {
          "pages": false,
          "time": false
        },
        "problem": null
      },
      "score": null,
      "fixes": [],
      "allowance": {
        "rescans_left": 5,
        "rescans_total": 5,
        "plan": "Full report",
        "lifetime": true,
        "can_buy_pack": false,
        "standing": {
          "state": "unstarted",
          "days_left": null,
          "writable": true
        },
        "next_step": {
          "key": "monitoring_basic",
          "label": "Watch this site every week",
          "url": "https://readinessindex.io/billing/checkout/basic",
          "message": "Basic scans this site every week and emails you when the score drops."
        },
        "pack_url": null
      },
      "index": {
        "version": "11.5",
        "date": "2026-10-11"
      },
      "notices": [
        {
          "key": "module_update_required",
          "message": "This version of the Readiness Index module is out of date. Update it from your site's plugin or module list.",
          "minimum": "2.0.0"
        }
      ]
    }
  }
}
