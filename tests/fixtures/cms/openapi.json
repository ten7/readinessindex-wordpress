            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Start one full scan of the site, or return the one already running.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanStarted"
                }
              }
            },
            "headers": {
              "X-Readiness-Notice": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "module_update_required"
                  ]
                },
                "description": "Present when the module is older than the server's minimum."
              }
            }
          },
          "401": {
            "description": "`error` is one of `unauthenticated`. `unauthenticated`: This site is not connected to a Readiness Index account, or its connection was removed, so connect it again.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "x-error-keys": [
              "unauthenticated"
            ],
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string"
                },
                "description": "Always `Bearer`."
              }
            }
          },
          "403": {
            "description": "`error` is one of `account_disabled`, `insufficient_scope`. `account_disabled`: This Readiness Index account is disabled, so its sites cannot be scanned or read.; `insufficient_scope`: This connection cannot make that kind of call.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "x-error-keys": [
              "account_disabled",
              "insufficient_scope"
            ]
          },
          "409": {
            "description": "`error` is one of `quota`. `quota`: This account has no rescans left.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "x-error-keys": [
              "quota"
            ]
          },
          "422": {
            "description": "`error` is one of `unreachable`. `unreachable`: The scanner cannot read this site as it is right now.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "x-error-keys": [
              "unreachable"
            ]
          },
          "429": {
            "description": "`error` is one of `rate_limited`. `rate_limited`: Too many calls too quickly, so wait a moment and try again.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "x-error-keys": [
              "rate_limited"
            ],
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds until a call is let through."
              }
            }
          },
          "500": {
            "description": "`error` is one of `internal_error`. `internal_error`: Something went wrong on our side, so try again in a minute.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "x-error-keys": [
              "internal_error"
            ]
          }
        },
        "x-write": true
      }
    },
