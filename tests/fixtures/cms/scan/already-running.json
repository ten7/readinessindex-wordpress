{
  "name": "scan/already-running",
  "description": "A second request while one is queued returns the same scan with `started` false and spends nothing.",
  "request": {
    "method": "POST",
    "path": "/cms/v1/scan",
    "headers": {
      "Authorization": "Bearer <cms key>",
      "User-Agent": "ReadinessIndex-WordPress/1.2.0 WordPress/6.6; https://example.com"
    }
  },
  "response": {
    "status": 202,
    "headers": {},
    "shape": "ScanStarted",
    "body": {
      "scan": "scan-token-4",
      "state": "pending",
      "started": false,
      "allowance": {
        "rescans_left": 4,
        "rescans_total": 5,
        "plan": "Full report",
        "lifetime": true,
        "can_buy_pack": false,
        "standing": {
          "state": "unstarted",
          "days_left": null,
          "writable": true
        },
        "next_step": {
          "key": "monitoring_basic",
          "label": "Watch this site every week",
          "url": "https://readinessindex.io/billing/checkout/basic",
          "message": "Basic scans this site every week and emails you when the score drops."
        },
        "pack_url": null
      }
    }
  }
}
