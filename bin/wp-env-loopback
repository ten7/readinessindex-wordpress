#!/usr/bin/env bash
# Let the plugin's site-own requests work inside wp-env.
#
# wp-env publishes WordPress at http://localhost:8888, but inside its container that port does
# not exist (Apache listens on 80), so a request the site makes to itself fails with cURL error
# 7 and "verify" can only say it could not look. (From the cli container the web container is
# the host named wordpress; from the web container itself it resolves to itself.) This writes a must-use plugin into the running
# site that sends such a request to the web container's own port 80 instead, keeping the Host header, so the fixers'
# verify step is exercised for real in a local run. It is a development aid for wp-env only:
# nothing here ships, and a real host needs none of it.
#
#   bin/wp-env-loopback          # for the development site (port 8888)
#   bin/wp-env-loopback tests    # for the test site (port 8889)
set -euo pipefail

cd "$(dirname "$0")/.."
target="${1:-cli}"
port=8888
web=wordpress
if [ "${target}" = "tests" ]; then
	target="tests-cli"
	port=8889
	web=tests-wordpress
fi

php_code=$(cat <<PHP
<?php
// wp-env development aid: a request to this site's published port goes to the container's own port 80.
add_filter(
	'pre_http_request',
	function ( \$pre, \$args, \$url ) {
		\$published = 'http://localhost:${port}';
		if ( 0 !== strpos( \$url, \$published ) ) {
			return \$pre;
		}
		\$args['headers']['Host'] = 'localhost:${port}';
		// The container's own address is not this site's host as far as the safe-request check knows.
		\$args['reject_unsafe_urls'] = false;
		return wp_remote_request( 'http://${web}' . substr( \$url, strlen( \$published ) ), \$args );
	},
	10,
	3
);
PHP
)
printf '%s\n' "${php_code}" | npx wp-env run "${target}" bash -c 'mkdir -p wp-content/mu-plugins && cat > wp-content/mu-plugins/ri-loopback.php'
echo "Loopback helper installed for ${target}."
