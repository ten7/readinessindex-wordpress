#!/usr/bin/env bash
# Build the release zip exactly as wordpress.org will receive it, then fail if it
# contains anything that is only for development.
#
# CI runs this same script, so the zip a person builds locally and the zip the
# release job builds are the same operation. The check at the end does not read
# .distignore: it asserts the outcome independently, so a pattern dropped from
# .distignore fails the build instead of quietly shipping tests or vendor/.
set -euo pipefail

cd "$(dirname "$0")/.."

slug="readiness-index"
version="$(sed -n 's/^ \* Version:[[:space:]]*//p' readiness-index.php | head -1)"
if [ -z "${version}" ]; then
	echo "Could not read Version from readiness-index.php" >&2
	exit 1
fi

out="dist"
stage="${out}/${slug}"
zip_path="${out}/${slug}-${version}.zip"

rm -rf "${out}"
mkdir -p "${stage}"

# --exclude-from takes .distignore as written: the same file wp dist-archive reads.
rsync -a --exclude-from=.distignore --exclude="/${out}" ./ "${stage}/"

# The zip's top-level folder is the slug, which is the directory WordPress
# installs into. Anything else would install as a second, differently named plugin.
(cd "${out}" && zip -qr -X "${slug}-${version}.zip" "${slug}")

echo "Built ${zip_path}"
echo
# Read the listing once into a variable. Piping unzip straight into grep -q under
# pipefail fails at random: grep exits on its first match, unzip takes SIGPIPE, and
# the pipeline reports failure for a file that is in the zip.
listing="$(unzip -Z1 "${zip_path}" | sort)"

echo "Contents:"
echo "${listing}"

# Entries that must never ship. Matched against each path inside the zip, after the slug.
forbidden='^readiness-index/(\.git|\.github|\.claude|\.wp-env|node_modules|vendor|tests|docs|bin|dist)(/|$)|^readiness-index/(\.|composer\.|package|phpcs|phpunit|patchwork|CLAUDE\.md|README\.md|\.distignore|\.editorconfig|\.gitignore)'
bad="$(echo "${listing}" | grep -E "${forbidden}" || true)"

if [ -n "${bad}" ]; then
	echo >&2
	echo "FAIL: the release zip contains development files:" >&2
	echo "${bad}" >&2
	exit 1
fi

for required in readiness-index.php readme.txt uninstall.php LICENSE src/Autoloader.php strings/en.json assets/admin.js assets/admin.css strings/plugin.en.json; do
	if ! echo "${listing}" | grep -qx "${slug}/${required}"; then
		echo "FAIL: the release zip is missing ${required}" >&2
		exit 1
	fi
done

echo
echo "OK: ${zip_path} contains no development files."

# A checksum beside the zip, so what was built can be compared with what is installed or attached
# to a release. Written with the zip's own name, so `shasum -a 256 -c` works in dist/.
( cd "$(dirname "${zip_path}")" && shasum -a 256 "$(basename "${zip_path}")" > SHA256SUMS && cat SHA256SUMS )
